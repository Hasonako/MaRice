# Reload sxhkd Keybinds
super + shift + Escape
	pkill -USR1 -x sxhkd; dunstify -u low -i ~/.config/bspwm/src/assets/reload.svg 'sxhkd' 'The configuration file has been reloaded successfully!'

# ----- Apps ----- #

# Apps
super + Escape
    rofi -show drun

# Terminal
super + Return
    kitty

# Start Apps
super + shift + {s, t, d, g, c, b, e}
	{spotify, Telegram, discord, steam, code, librewolf, thunar}

# Vol Inc
XF86AudioRaiseVolume
	pactl set-sink-volume @DEFAULT_SINK@ +5%

# Vol Dic
XF86AudioLowerVolume
	pactl set-sink-volume @DEFAULT_SINK@ -5%

# Mute
XF86AudioMute
	pactl set-sink-mute @DEFAULT_SINK@ toggle

# Brightness up
XF86MonBrightnessUp
	brightnessctl set +10%

# Brightness down
XF86MonBrightnessDown
	brightnessctl set -10%

#Hide/Show Bar
super + alt + {h,u}
	HideBar {-h,-u}

# Change layout
Alt_L + shift
    ~/.bin/change_layout.sh

Shift_L + alt
    ~/.bin/change_layout.sh

#Screenshot
Print
    flameshot full -c

super + shift + s
    flameshot gui

# ----- Bspwm ----- #

# quit/restart bspwm
ctrl + shift + {q,r}
    bspc {quit,wm -r}

# Select window to close
ctrl + super + alt + k
	{xkill}

# close and kill
super + c
    bspc node -c

# Workspace
super + {1-9}
    bspc desktop -f ^{1-9}

# Lockscreen
super + shift + l
    ~/.bin/lock.sh

# Expanding windows
super + control {h,j,k,l}
    bspc node -z {left -20 0,right 20 0,top 0 -20,bottom 0 20}

super + button1
    ~/.bin/resize_corner.sh

super + @button1
    ~/.bin/float_and_drag.sh

# ----- Focus/Swap Nodes ----- #

# Rotate desktop
super + Tab
	bspc node @/ --rotate {90,-90}

# Switch workspace
super + {Left,Right}
	bspc desktop -f {prev,next}

# Send focused Node to workspace directionally
super + ctrl + {Left,Right}
	bspc node -d {prev,next} '--follow'

# Resize window with mouse (hold super + right-click)
super + button3
    bspc node -r

# ----- Expand/Shrink Nodes ----- #

# Focus window in direction
super + {h,j,k,l}
    bspc node -f {west,south,north,east}

# Resize tiled windows only
super + alt + {Left,Down,Up,Right}
    bspc node -z {left -20 0,down 0 20,up 0 -20,right 20 0}